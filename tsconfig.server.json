{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "outDir": "build",
    // CommonJS output, so Node resolves the extensionless relative imports the
    // client code uses. Emitting ESM would mean rewriting every import in
    // src/sim and src/net to carry a .js suffix — churn in the shared code to
    // suit one of its two consumers.
    "module": "CommonJS",
    "moduleResolution": "Node10",
    "lib": ["ES2022"],
    "types": ["node"]
  },
  "include": ["server/**/*.ts", "src/net/**/*.ts", "src/sim/**/*.ts", "src/fighters/**/*.ts", "src/combat/**/*.ts"],
  // These are browser-only: OnlineClient reads `location`, WebRtcTransport needs
  // RTCPeerConnection. The server loads neither, and including them would drag
  // the DOM lib into a Node build.
  "exclude": [
    "**/__tests__/**",
    "src/net/OnlineClient.ts",
    "src/net/onlineMatch.ts",
    "src/net/WebRtcTransport.ts"
  ]
}
