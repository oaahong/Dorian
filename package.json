{
  "name": "meme-cat-fighter",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:cov": "vitest run --coverage",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm run test && npm run test:e2e",
    "release:notes": "node scripts/release-notes.mjs",
    "release:patch": "node scripts/release.mjs patch",
    "release:minor": "node scripts/release.mjs minor",
    "release:major": "node scripts/release.mjs major",
    "preversion": "npm run verify",
    "version": "node scripts/release-notes.mjs > /dev/null",
    "postversion": "git push --follow-tags origin HEAD",
    "build:server": "tsc --project tsconfig.server.json",
    "dev:server": "npm run build:server && echo '{\"type\":\"commonjs\"}' > build/package.json && node build/server/main.js",
    "start": "node build/server/main.js",
    "assets:poses": "python3 scripts/extract_poses.py",
    "assets:poses:validate": "python3 scripts/validate_pose_regeneration.py",
    "assets:skills": "python3 scripts/extract_skill_assets.py && npm run assets:skills:codegen",
    "assets:skills:codegen": "node scripts/gen-skill-cells.mjs",
    "assets:skills:validate": "python3 scripts/validate_skill_assets.py",
    "assets:skills:contacts": "python3 scripts/generate_skill_contact_sheets.py",
    "assets:thumbs": "bash -c 'for f in public/assets/cards/card-*.png; do cwebp -quiet -q 85 -alpha_q 100 -resize 476 596 \"$f\" -o \"public/assets/thumbs/$(basename \"$f\" .png).webp\"; done'"
  },
  "dependencies": {
    "phaser": "^4.2.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^26.2.0",
    "@types/ws": "^8.18.1",
    "@vitest/coverage-v8": "^4.1.10",
    "fast-check": "^4.9.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.2",
    "vitest": "^4.1.10"
  }
}
